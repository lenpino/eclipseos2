/**
 * VAC build file for SWT libraries on OS/2
 */

option ProjectOptions =
    info( cnd, no ) // disable "condition always true" messages
{
    option
        link( pmtype, pm ),
        link( linkwithmultithreadlib),
        link( linkwithsharedlib),
        define( DEBUG_CHECK_NULL_EXCEPTIONS )
//	define( DEBUG_CALL ),
//       opt( level, "2" )
    {
        target $SWT_LIB
        {
		source type(lib) "ft2lib.lib"
            	source "editcol.c", "editcol.h", "editcol.rc", "swt.c", "structs.c", "callback.c"
        }
    }
}
