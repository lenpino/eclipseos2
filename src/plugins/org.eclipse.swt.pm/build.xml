<?xml version="1.0" encoding="UTF-8"?>
<project name="org.eclipse.swt.pm" default="build.jars" basedir=".">

    <target name="init" depends="properties">
        <property name="fragment" value="org.eclipse.swt.pm"/>
        <property name="version.suffix" value="_2.0.1"/>
        <property name="full.name" value="${fragment}${version.suffix}"/>
        <property name="temp.folder" value="${basedir}/temp.folder"/>
        <property name="plugin.destination" value="${basedir}"/>
        <property name="build.result.folder" value="${basedir}"/>
        <property name="plugindir" value="../org.eclipse.swt"/>
        <property name="os" value="os2"/>
        <property name="bootclasspath" value=""/>

	<property name="plugindir.orig" value="${eclipsedir.orig}/plugins/org.eclipse.swt"/>

    </target>

    <target name="properties" if="eclipse.running">
        <property name="build.compiler" value="org.eclipse.jdt.core.JDTCompilerAdapter"/>
    </target>

    <target name="build.update.jar" depends="init">
        <delete dir="${temp.folder}"/>
        <mkdir dir="${temp.folder}"/>
        <antcall target="build.jars"/>
        <antcall target="gather.bin.parts">
            <param name="destination.temp.folder" value="${temp.folder}/"/>
        </antcall>
        <zip zipfile="${plugin.destination}/${full.name}.jar" basedir="${temp.folder}/${full.name}" filesonly="false"/>
        <delete dir="${temp.folder}"/>
    </target>

    <target name="ws/pm/swt.jar" depends="init" unless="ws/pm/swt.jar">
        <property name="destdir" value="${temp.folder}/ws/pm/swt.jar.bin"/>
        <delete dir="${temp.folder}/ws/pm/swt.jar.bin"/>
        <mkdir dir="${temp.folder}/ws/pm/swt.jar.bin"/>
        <!--javac destdir="${temp.folder}/ws/pm/swt.jar.bin" verbose="true" debug="on" failonerror="no" bootclasspath="${bootclasspath}"-->
        <javac destdir="${temp.folder}/ws/pm/swt.jar.bin" debug="on" failonerror="no" bootclasspath="${bootclasspath}" includesfile="classes.inc">
            <src path="${plugindir}/Eclipse SWT/pm/" />
            <src path="${plugindir.orig}/Eclipse SWT/common/" />
            <src path="${plugindir.orig}/Eclipse SWT/common_j2se/" />

            <src path="${plugindir}/Eclipse SWT PI/pm/" />
            <src path="${plugindir}/Eclipse SWT PI/common_j2se/" />

            <!-- possible to implement OLE under OS/2? -->
            <!-- src path="${plugindir}/Eclipse SWT OLE OS2/pm/" / -->

            <!-- possible to implement Accessibility under OS/2 or should be emulated? -->
            <src path="${plugindir.orig}/Eclipse SWT Accessibility/emulated/" />
            <src path="${plugindir.orig}/Eclipse SWT Accessibility/common/" />

            <!-- possible to implement AWT under OS/2? -->
            <!-- src path="${plugindir}/Eclipse SWT AWT/pm/"/ -->

            <!-- src path="${plugindir}/Eclipse SWT Drag and Drop/pm/"/ -->
            <!-- src path="${plugindir}/Eclipse SWT Drag and Drop/common/"/ -->
            <!-- src path="${plugindir}/Eclipse SWT Printing/pm/"/ -->
            <!-- src path="${plugindir}/Eclipse SWT Printing/common/"/ -->
            <!-- src path="${plugindir}/Eclipse SWT Program/pm/"/ -->
            <!-- src path="${plugindir}/Eclipse SWT Program/common/"/ -->
            <!-- src path="${plugindir}/Eclipse SWT Custom Widgets/common/"/ -->
        </javac>
        <property name="includes" value=""/>
        <property name="excludes" value="**/*.java,**/*.bak,**/library/,**/.nbattrs"/>
        <copy todir="${temp.folder}/ws/pm/swt.jar.bin">
            <fileset dir="${plugindir}/Eclipse SWT/pm/" includes="${includes}" excludes="${excludes}"/>
            <fileset dir="${plugindir.orig}/Eclipse SWT/common/" includes="${includes}" excludes="${excludes}"/>
            <fileset dir="${plugindir.orig}/Eclipse SWT/common_j2se/" includes="${includes}" excludes="${excludes}"/>
            <fileset dir="${plugindir}/Eclipse SWT PI/pm/" includes="${includes}" excludes="${excludes}"/>
            <fileset dir="${plugindir}/Eclipse SWT PI/common_j2se/" includes="${includes}" excludes="${excludes}"/>
            <!-- fileset dir="${plugindir}/Eclipse SWT OLE OS2/pm/" includes="${includes}" excludes="${excludes}"/ -->
            <fileset dir="${plugindir.orig}/Eclipse SWT Accessibility/emulated/" includes="${includes}" excludes="${excludes}"/>
            <fileset dir="${plugindir.orig}/Eclipse SWT Accessibility/common/" includes="${includes}" excludes="${excludes}"/>
            <!-- fileset dir="${plugindir}/Eclipse SWT AWT/pm/" includes="${includes}" excludes="${excludes}"/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Drag and Drop/pm/" includes="${includes}" excludes="${excludes}"/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Drag and Drop/common/" includes="${includes}" excludes="${excludes}"/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Printing/pm/" includes="${includes}" excludes="${excludes}"/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Printing/common/" includes="${includes}" excludes="${excludes}"/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Program/pm/" includes="${includes}" excludes="${excludes}"/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Program/common/" includes="${includes}" excludes="${excludes}"/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Custom Widgets/common/" includes="${includes}" excludes="${excludes}"/ -->
        </copy>
        <!-- filter out files and folders that should not be included in the swt.jar -->
        <delete dir="${temp.folder}/ws/pm/swt.jar.bin/Eclipse SWT PI/pm/library/"/>
        <delete dir="${temp.folder}/ws/pm/swt.jar.bin/Eclipse SWT/common/library/"/>

        <mkdir dir="${build.result.folder}/ws/pm/"/>
        <jar jarfile="${build.result.folder}/ws/pm/swt.jar" basedir="${temp.folder}/ws/pm/swt.jar.bin"/>
        <delete dir="${temp.folder}/ws/pm/swt.jar.bin"/>
        <mkdir dir="${plugindir}/ws/pm"/>
    </target>

    <target name="build.jars" depends="init">
        <available property="ws/pm/swt.jar" file="${build.result.folder}/ws/pm/swt.jar"/>
        <antcall target="ws/pm/swt.jar"/>
    </target>

    <target name="ws/pm/swtsrc.zip" depends="init" unless="ws/pm/swtsrc.zip">
        <mkdir dir="${build.result.folder}/ws/pm"/>
        <zip zipfile="${build.result.folder}/ws/pm/swtsrc.zip">
            <fileset dir="${plugindir}/Eclipse SWT/pm/" includes="**/*.java" excludes=""/>
            <fileset dir="${plugindir}/Eclipse SWT/common/library/"/>
            <fileset dir="${plugindir.orig}/Eclipse SWT/common/" includes="**/*.java" excludes=""/>
            <fileset dir="${plugindir.orig}/Eclipse SWT/common_j2se/" includes="**/*.java" excludes=""/>
            <fileset dir="${plugindir}/Eclipse SWT PI/pm/" includes="**/*.java" excludes=""/>
            <fileset dir="${plugindir}/Eclipse SWT PI/pm/library/"/>
            <fileset dir="${plugindir}/Eclipse SWT PI/common_j2se/" includes="**/*.java" excludes=""/>
            <!-- fileset dir="${plugindir}/Eclipse SWT OLE OS2/pm/" includes="**/*.java" excludes=""/ -->
            <fileset dir="${plugindir.orig}/Eclipse SWT Accessibility/emulated/" includes="**/*.java" excludes=""/>
            <fileset dir="${plugindir.orig}/Eclipse SWT Accessibility/common/" includes="**/*.java" excludes=""/>
            <!-- fileset dir="${plugindir}/Eclipse SWT AWT/pm/" includes="**/*.java" excludes=""/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Drag and Drop/pm/" includes="**/*.java" excludes=""/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Drag and Drop/common/" includes="**/*.java" excludes=""/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Printing/pm/" includes="**/*.java" excludes=""/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Printing/common/" includes="**/*.java" excludes=""/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Program/pm/" includes="**/*.java" excludes=""/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Program/common/" includes="**/*.java" excludes=""/ -->
            <!-- fileset dir="${plugindir}/Eclipse SWT Custom Widgets/common/" includes="**/*.java" excludes=""/ -->
        </zip>
    </target>

    <target name="build.sources" depends="init">
        <available property="ws/pm/swtsrc.zip" file="${build.result.folder}/ws/pm/swtsrc.zip"/>
        <antcall target="ws/pm/swtsrc.zip"/>
    </target>

    <target name="build.zips" depends="init">
    </target>

    <target name="gather.sources" depends="init" if="destination.temp.folder">
        <mkdir dir="${destination.temp.folder}/${full.name}/ws/pm"/>
        <copy file="${build.result.folder}/ws/pm/swtsrc.zip" todir="${destination.temp.folder}/${full.name}/ws/pm"/>
        <copy todir="${destination.temp.folder}/${full.name}">
            <fileset dir="${basedir}" includes="about.html"/>
        </copy>
    </target>

    <target name="gather.logs" depends="init" if="destination.temp.folder">
        <mkdir dir="${destination.temp.folder}/${full.name}/ws/pm"/>
        <copy file="${temp.folder}/ws/pm/swt.jar.bin.log" todir="${destination.temp.folder}/${full.name}/ws/pm"/>
    </target>

    <target name="gather.bin.parts" depends="init" if="destination.temp.folder">
        <mkdir dir="${destination.temp.folder}/${full.name}/ws/pm"/>
        <copy file="${build.result.folder}/ws/pm/swt.jar" todir="${destination.temp.folder}/${full.name}/ws/pm"/>
        <copy todir="${destination.temp.folder}/${full.name}">
            <fileset dir="${basedir}" includes="fragment.xml,about.html,os/${os}/"/>
        </copy>
    </target>

    <target name="clean" depends="init">
        <delete file="${build.result.folder}/ws/pm/swt.jar"/>
        <delete file="${build.result.folder}/ws/pm/swtsrc.zip"/>
        <delete file="${plugin.destination}/${full.name}.jar"/>
        <delete file="${plugin.destination}/${full.name}.zip"/>
        <delete dir="${temp.folder}"/>
    </target>

    <target name="refresh" depends="init" if="eclipse.running">
        <eclipse.refreshLocal resource="${fragment}" depth="infinite"/>
    </target>

    <target name="zip.plugin" depends="init">
        <delete dir="${temp.folder}"/>
        <mkdir dir="${temp.folder}"/>
        <antcall target="build.jars"/>
        <antcall target="build.sources"/>
        <antcall target="gather.bin.parts">
            <param name="destination.temp.folder" value="${temp.folder}/"/>
        </antcall>
        <antcall target="gather.sources">
            <param name="destination.temp.folder" value="${temp.folder}/"/>
        </antcall>
        <delete>
            <fileset dir="${temp.folder}" includes="**/*.bin.log"/>
        </delete>
        <zip zipfile="${plugin.destination}/${full.name}.zip" basedir="${temp.folder}" filesonly="true"/>
        <delete dir="${temp.folder}"/>
    </target>

</project>