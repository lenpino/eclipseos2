    <!-- creates the default build.prp if nesessary -->
    <target name="build.prp" depends="init" unless="is.build.prp">
        <echo file="${build.prp}">
            
# build.prp: EclipseOS2 build options

# path to the original Eclipse source distribution
eclipsedir.orig=x:/apps/dev/fuentes/eclipse2.0.1

# default part and step number for test (run) target
# currently the value for part can be 'swt' only
test.part.default=swt
test.step.default=001
# does test target depend on compile
test.dependoncompile=false
# the JVM to use for launching testcases.
# if commented the current JVM will be used.
# this property is intended to make it possible to compile
# Eclipse under one JVM and run it under another
#test.jvm=C:/Java131/jre/bin/java.exe

# path where to find Java runtime library.
# if the project is being built under OS/2, this can be left
# commented to be picked up from the current JVM environment
#bootclasspath=C:/Java131/jre/lib/rt.jar

# JNI-API call profiler (to detect system resource leaks).
# set to true to enable (you must have the dll and the reporter,
# they are not in CVS for now)
test.apiprofiler=false
# path to the profiled version of SWT DLL (generates swtstats.scratch.log)
test.apiprofiler.dllpath=path_to_dll
# filename of the reporting tool (understands -raw and -report options)
test.apiprofiler.tool=path_to_exe/EDLLReport.exe

        </echo>
        <condition property="cr" value="&#13;">
            <os family="os/2" />
        </condition>
        <property name="cr" value="" />
        <fail>
${cr}
${cr}The default build properties file (${build.prp}) has been created.
${cr}Please customize it to your environment and rerun the build.
        </fail>
    </target>

