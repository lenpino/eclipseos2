<?xml version="1.0" encoding="UTF-8"?>
<project name="EclipseOS2 Transitional Project Build" default="help">

    <!-- main build directory, $CVSROOT -->
    <property name="basedir.main" value="${basedir}" />

    <!-- user defined build properties file -->
    <property name="build.prp" value="${basedir}/build.prp" />
    <property file="${build.prp}"/>

    <!--  default setting for bootclasspath if none specified  -->
    <property name="bootclasspath" value="${java.home}/lib/rt.jar" />
    <!--  default setting for test.jvm if none specified  -->
    <property name="test.jvm" value="${java.home}/bin/java" />

    <!-- path to compiled classes in development mode -->
    <property name="dev.classes" value="${basedir}/-classes-" />

    <!-- Definitions for AntHelper jEdit Plugin BEGIN -->
    <path id="ah.classpath">
        <pathelement path="${dev.classes}"/>
    </path>
    <path id="ah.sourcepath">
        <pathelement path="${basedir}/src/plugins/org.eclipse.swt/Eclipse SWT PI/pm"/>
        <pathelement path="${basedir}/src/plugins/org.eclipse.swt/Eclipse SWT/pm"/>
    </path>
    <!-- Definitions for AntHelper jEdit Plugin END -->
    
    <target name="init">
        <record name="${basedir}/build.log" action="start" />
        <available file="${build.prp}" property="is.build.prp" />
    </target>

    <!-- compile everything in development mode -->
    <target name="compile" depends="build.prp">
        <ant antfile="build.xml" target="compile" dir="tests/SWT" />
    </target>

    <!-- compile SWT dll -->
    <target name="dll">
	<mkdir dir="src/plugins/org.eclipse.swt.pm/os/os2/x86"/>
        <exec executable="build.cmd" vmlauncher="false" dir="src/plugins/org.eclipse.swt/Eclipse SWT PI/pm/library">
        </exec>
    </target>

    <!-- run the cvs2cl script to generate ChangeLog -->
    <target name="changelog">
        <exec executable="cvs2cl.pl.cmd" vmlauncher="false" dir="misc">
            <arg value="--fsf"/>
        </exec>
    </target>

    <!-- run particular test that set as default in build.prp -->
    <target name="test" depends="build.prp">
        <property name="test.step" value="${test.step.default}" />
        <antcall target="${test.part.default}.test" />
    </target>

    <!-- cleans all subparts -->
    <target name="clean" depends="init,build.prp">
        <ant antfile="build.xml" target="clean" dir="src/plugins/org.eclipse.swt.pm" />
        <ant antfile="build.xml" target="clean" dir="tests/SWT" />
        <exec executable="build.cmd" vmlauncher="false" dir="src/plugins/org.eclipse.swt/Eclipse SWT PI/pm/library">
        <arg value="clean"/>
        </exec>
    </target>

    <!-- original way of SWT compilation -->
    <target name="swt.jar" depends="init,build.prp">
        <ant antfile="build.xml" target="clean" dir="src/plugins/org.eclipse.swt.pm" />
        <ant antfile="build.xml" target="build.jars" dir="src/plugins/org.eclipse.swt.pm" />
    </target>

    <!-- boot.jar -->
    <target name="boot.jar" depends="init,build.prp">
        <ant antfile="build.xml" target="clean" dir="src/plugins/org.eclipse.core.boot" />
        <ant antfile="build.xml" target="build.jars" dir="src/plugins/org.eclipse.core.boot" />
    </target>

    <!-- startup.jar -->
    <target name="startup.jar" depends="init,build.prp">
        <ant antfile="build.xml" target="clean" dir="src/plugins/org.eclipse.platform" />
        <ant antfile="build.xml" target="build.jars" dir="src/plugins/org.eclipse.platform" />
    </target>

    <!-- common point to run SWT testcase -->
    <target name="swt.test" depends="build.prp">
        <ant antfile="build.xml" target="run" dir="tests/SWT" />
    </target>

